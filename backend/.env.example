# Copy to .env for local development. Never commit .env or put secrets in frontend variables.
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=sqlite:///database.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: required only for AI features. Keep this value on the backend.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_RETRIES=3
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=SkillPilot AI
JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=30
MAX_CONTENT_LENGTH=2097152
PORT=5000
# Optional: provisions an initial admin account at startup when both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
